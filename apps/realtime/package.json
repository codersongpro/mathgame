{
  "name": "@bubble-semble/realtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --max-workers=1 --no-isolate"
  },
  "dependencies": {
    "@bubble-semble/game-core": "workspace:*",
    "@bubble-semble/shared": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.1",
    "@cloudflare/workers-types": "^5.20260921.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.135.0"
  }
}
