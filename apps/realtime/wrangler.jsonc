{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bubble-semble-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "env": {
    "preview": {
      "name": "bubble-semble-realtime-preview",
      "durable_objects": {
        "bindings": [
          {
            "name": "GAME_ROOM",
            "class_name": "GameRoom"
          }
        ]
      },
      "migrations": [
        {
          "tag": "preview-v1",
          "new_sqlite_classes": ["GameRoom"]
        }
      ]
    },
    "production": {
      "name": "bubble-semble-realtime-production",
      "durable_objects": {
        "bindings": [
          {
            "name": "GAME_ROOM",
            "class_name": "GameRoom"
          }
        ]
      },
      "migrations": [
        {
          "tag": "production-v1",
          "new_sqlite_classes": ["GameRoom"]
        }
      ]
    }
  }
}
